{
  "version": 2,
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/server/server.js" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
