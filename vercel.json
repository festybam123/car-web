{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node",
      "config": {
        "buildCommand": "npm run build --prefix client && node copy-to-server.js"
      }
    }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/server/server.js" },
    { "src": "^/(.*)$", "dest": "/server/server.js" }
  ]
}
